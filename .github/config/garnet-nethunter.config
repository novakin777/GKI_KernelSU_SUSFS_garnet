# Poco X6 5G / Redmi Note 13 Pro 5G (garnet)
# LineageOS SM7435 5.10.260 additions for DroidSpaces and AR9271.

# Preserve the release string used by the current PixelOS kernel and its DLKMs.
CONFIG_LOCALVERSION="-gki-g7ee66f07cebf"
# CONFIG_LOCALVERSION_AUTO is not set

# Containers / DroidSpaces
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_SYSVIPC=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Atheros AR9271 / TP-Link TL-WN722N v1
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_CFG80211=m
CONFIG_CFG80211_WEXT=y
CONFIG_MAC80211=m
CONFIG_ATH_COMMON=m
CONFIG_ATH9K_HW=m
CONFIG_ATH9K_COMMON=m
CONFIG_ATH9K_HTC=m

# Diagnostics useful for monitor-mode and injection testing.
CONFIG_DEBUG_FS=y
CONFIG_CFG80211_DEBUGFS=y
CONFIG_MAC80211_DEBUGFS=y
CONFIG_ATH9K_HTC_DEBUGFS=y
