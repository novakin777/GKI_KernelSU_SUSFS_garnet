# Poco X6 5G / Redmi Note 13 Pro 5G (garnet)
# LineageOS SM7435 5.10.260 additions for DroidSpaces and AR9271.

# The workflow supplies LOCALVERSION explicitly so a dirty source tree cannot
# append "+" after applying KernelSU/DroidSpaces patches.
CONFIG_LOCALVERSION=""
# CONFIG_LOCALVERSION_AUTO is not set

# Containers / DroidSpaces
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BINFMT_MISC=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BINFMT_ELF=y

# Atheros AR9271 / TP-Link TL-WN722N v1
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_CFG80211=m
CONFIG_CFG80211_WEXT=y
CONFIG_MAC80211=m
CONFIG_ATH_COMMON=m
CONFIG_ATH9K_HW=m
CONFIG_ATH9K_COMMON=m
CONFIG_ATH9K_HTC=m

# Diagnostics useful for monitor-mode and injection testing.
CONFIG_DEBUG_FS=y
CONFIG_CFG80211_DEBUGFS=y
CONFIG_MAC80211_DEBUGFS=y
CONFIG_ATH9K_HTC_DEBUGFS=y

# KernelSU Next v3.3.0, built into Image (not LKM).
CONFIG_KPROBES=y
CONFIG_KSU=y
# CONFIG_KSU_DEBUG is not set
